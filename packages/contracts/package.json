{
  "name": "@cagnotte/contracts",
  "version": "0.1.0",
  "description": "The request schemas of the Cagnotte API, as zod, shared by the server that parses them and the app that validates its forms with them.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cagnotte/domain": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
