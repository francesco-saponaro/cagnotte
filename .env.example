# The API (apps/api). Copy to .env; docker compose reads the same names.
DATABASE_URL=postgres://cagnotte:cagnotte@127.0.0.1:5432/cagnotte
PORT=3001
HOST=0.0.0.0
# Where the web app is served from in development, for CORS. Empty means same origin only.
WEB_ORIGIN=http://localhost:8081
# Sessions expire after this many hours.
SESSION_HOURS=72

# The app (apps/mobile). Empty means demo mode: the use cases run in the browser on PGlite.
EXPO_PUBLIC_API_URL=http://localhost:3001
