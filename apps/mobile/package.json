{
  "name": "@cagnotte/mobile",
  "version": "0.1.0",
  "description": "The Cagnotte app: iOS, Android and the web export that is the live demo.",
  "license": "MIT",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/demo-assets.mjs && expo start --web",
    "build": "node scripts/demo-assets.mjs && expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@cagnotte/contracts": "workspace:*",
    "@cagnotte/domain": "workspace:*",
    "@cagnotte/handlers": "workspace:*",
    "@cagnotte/postgres": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "@expo-google-fonts/geist": "^0.4.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@tanstack/react-query": "^5.107.1",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.24",
    "expo-constants": "~58.0.16",
    "expo-font": "^58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
