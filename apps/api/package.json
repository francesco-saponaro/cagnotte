{
  "name": "@cagnotte/api",
  "version": "0.1.0",
  "description": "The Cagnotte API: a Fastify server over PostgreSQL that exposes the use cases as HTTP routes.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@cagnotte/contracts": "workspace:*",
    "@cagnotte/domain": "workspace:*",
    "@cagnotte/handlers": "workspace:*",
    "@cagnotte/postgres": "workspace:*",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
