{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@cagnotte/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@cagnotte/postgres": [
        "../../packages/postgres/src/index.ts"
      ],
      "@cagnotte/postgres/*": [
        "../../packages/postgres/src/*"
      ],
      "@cagnotte/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@cagnotte/handlers": [
        "../../packages/handlers/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts"
  ]
}
